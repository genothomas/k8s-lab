---
# cilium-envoy runs under cilium-envoy-starter which drops all caps before
# exec. Re-grant NET_BIND_SERVICE so the child can bind host 80/443 for
# Gateway API listeners.

envoy:
  securityContext:
    capabilities:
      keepCapNetBindService: true
      envoy:
        - NET_ADMIN
        - SYS_ADMIN
        - NET_BIND_SERVICE

# Cilium 1.18+ chart reads these optional values. With --reuse-values
# they're nil in the existing release and the template panics on
# `nil pointer evaluating interface{}.enabled`. Set both to false
# explicitly — lab doesn't use these features.
hubble:
  metrics:
    dynamic:
      enabled: false

tls:
  secretSync:
    enabled: false
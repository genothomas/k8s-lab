---
# Externally-managed AM config Secret for the VM chart.
# The chart's config-reloader reads `alertmanager.yaml.gz` from
# spec.configSecret. We provide both keys for compat.
# Receivers must be non-empty strings — YAML null is rejected as
# "missing name in receiver".

apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-vm-external
  namespace: {{ monitoring_namespace }}
  labels:
    app.kubernetes.io/name: alertmanager
    app.kubernetes.io/managed-by: vm-operator
type: Opaque
stringData:
  alertmanager.yaml: |
    route:
      receiver: default
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 4h
      routes:
        - matchers:
            - severity="critical"
          receiver: primary
          continue: false
        - matchers:
            - severity="warning"
          receiver: default
    receivers:
      - name: default
      - name: primary
        webhook_configs:
          - url: {{ alertmanager_webhook_url | mandatory }}
            send_resolved: true
            max_alerts: 0
            # lab_runbook_url alongside the upstream runbook_url (chart's
            # defaultRules embed runbooks.prometheus-operator.dev URLs).
            payload: |
              {
                "status": "{% raw %}{{ .Status }}{% endraw %}",
                "alertname": "{% raw %}{{ .CommonLabels.alertname }}{% endraw %}",
                "severity": "{% raw %}{{ .CommonLabels.severity }}{% endraw %}",
                "summary": "{% raw %}{{ .CommonAnnotations.summary }}{% endraw %}",
                "description": "{% raw %}{{ .CommonAnnotations.description }}{% endraw %}",
                "runbook_url": "{% raw %}{{ .CommonAnnotations.runbook_url }}{% endraw %}",
                "lab_runbook_url": "https://runbooks.{{ dns_zone }}/{% raw %}{{ .CommonLabels.alertname }}{% endraw %}",
                "fingerprint": "{% raw %}{{ (index .Alerts 0).Fingerprint }}{% endraw %}"
              }
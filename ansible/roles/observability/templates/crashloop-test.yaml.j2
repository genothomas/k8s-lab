---
# Deterministic crash-loop test workload for KubePodCrashLooping alert.
# `sleep 5; exit 1` + Always restart → CrashLoopBackOff in ~30s.
# Apply via kubectl apply when needed for alert testing, then delete.
# NOT applied by the observability playbook — manual invocation.

apiVersion: apps/v1
kind: Deployment
metadata:
  name: crashloop-test
  namespace: {{ monitoring_namespace }}
  labels:
    app.kubernetes.io/name: crashloop-test
    purpose: alert-testing
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: crashloop-test
  template:
    metadata:
      labels:
        app.kubernetes.io/name: crashloop-test
    spec:
      restartPolicy: Always
      containers:
        - name: crash
          image: busybox:1.36
          command: ["/bin/sh", "-c", "sleep 5; exit 1"]
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 50m
              memory: 32Mi
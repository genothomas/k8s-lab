apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-prod
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: {{ cert_letsencrypt_email }}
    privateKeySecretRef:
      name: letsencrypt-prod-account
    solvers:
{% if enable_dns %}
      - dns01:
          cloudflare:
            apiTokenSecretRef:
              name: cloudflare-api-token
              key: api-token
{% else %}
      - http01:
          gatewayHTTPRoute:
            parentRefs:
              - name: web
                namespace: web
                kind: Gateway
{% endif %}